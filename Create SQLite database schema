    private void addRecipe(SQLiteDatabase db,String name,String steps,String[] ingredients,double[] qty,String[] units){
        ContentValues v=new ContentValues();v.put("name",name);v.put("steps",steps);long id=db.insert("recipes",null,v);
        for(int i=0;i<ingredients.length;i++){ContentValues x=new ContentValues();x.put("recipe_id",id);x.put("name",ingredients[i]);x.put("quantity",qty[i]);x.put("unit",units[i]);db.insert("recipe_ingredients",null,x);}
    }
    public List<PantryItem> getPantry(){List<PantryItem> a=new ArrayList<>();Cursor c=getReadableDatabase().rawQuery("SELECT id,name,quantity,unit,expiry FROM pantry ORDER BY name",null);try{while(c.moveToNext())a.add(new PantryItem(c.getInt(0),c.getString(1),c.getDouble(2),c.getString(3),c.getString(4)));}finally{c.close();}return a;}
    public long savePantry(int id,String name,double qty,String unit,String expiry){ContentValues v=new ContentValues();v.put("name",name);v.put("quantity",qty);v.put("unit",unit);v.put("expiry",expiry);if(id>0)return getWritableDatabase().update("pantry",v,"id=?",new String[]{String.valueOf(id)});return getWritableDatabase().insert("pantry",null,v);}
    public void deletePantry(int id){getWritableDatabase().delete("pantry","id=?",new String[]{String.valueOf(id)});}
    public List<Recipe> getSuggested(){List<Recipe> out=new ArrayList<>();List<PantryItem> pantry=getPantry();Cursor r=getReadableDatabase().rawQuery("SELECT id,name,steps FROM recipes ORDER BY name",null);try{while(r.moveToNext()){Recipe rec=new Recipe(r.getInt(0),r.getString(1),r.getString(2));if(matches(rec.id,pantry))out.add(rec);}}finally{r.close();}return out;}
    private boolean matches(int recipeId,List<PantryItem> pantry){Cursor c=getReadableDatabase().rawQuery("SELECT name,quantity,unit FROM recipe_ingredients WHERE recipe_id=?",new String[]{String.valueOf(recipeId)});try{while(c.moveToNext()){String wanted=normalize(c.getString(0));double needed=c.getDouble(1);String unit=c.getString(2);double available=0;for(PantryItem p:pantry)if(normalize(p.name).equals(wanted)&&compatible(p.unit,unit)){available+=convert(p.quantity,p.unit,unit);}if(available+1e-9<needed)return false;}return true;}finally{c.close();}}
    public List<String> getRecipeIngredients(int id){List<String> a=new ArrayList<>();Cursor c=getReadableDatabase().rawQuery("SELECT name,quantity,unit FROM recipe_ingredients WHERE recipe_id=? ORDER BY id",new String[]{String.valueOf(id)});try{while(c.moveToNext())a.add(c.getString(0)+" — "+format(c.getDouble(1))+" "+c.getString(2));}finally{c.close();}return a;}
    public Recipe getRecipe(int id){Cursor c=getReadableDatabase().rawQuery("SELECT id,name,steps FROM recipes WHERE id=?",new String[]{String.valueOf(id)});try{if(c.moveToFirst())return new Recipe(c.getInt(0),c.getString(1),c.getString(2));return null;}finally{c.close();}}
    public static String normalize(String s){String x=s==null?"":s.trim().toLowerCase(Locale.ROOT).replaceAll("[^a-z0-9 ]","").replaceAll("\\s+"," ");String[] words=x.split(" ");StringBuilder b=new StringBuilder();for(String w:words){if(w.endsWith("ies")&&w.length()>4)w=w.substring(0,w.length()-3)+"y";else if(w.endsWith("oes")&&w.length()>4)w=w.substring(0,w.length()-2);else if(w.endsWith("s")&&!w.endsWith("ss")&&w.length()>3)w=w.substring(0,w.length()-1);if(b.length()>0)b.append(' ');b.append(w);}return b.toString();}
    private boolean compatible(String a,String b){return base(a).equals(base(b));}
    private String base(String u){u=u==null?"":u.trim().toLowerCase(Locale.ROOT);if(u.equals("kg")||u.equals("g"))return "mass";if(u.equals("l")||u.equals("ml"))return "volume";return u;}
    private double convert(double q,String from,String to){from=from.toLowerCase(Locale.ROOT);to=to.toLowerCase(Locale.ROOT);if(from.equals(to))return q;if(from.equals("kg")&&to.equals("g"))return q*1000;if(from.equals("g")&&to.equals("kg"))return q/1000;if(from.equals("l")&&to.equals("ml"))return q*1000;if(from.equals("ml")&&to.equals("l"))return q/1000;return q;}
    private String format(double d){return d==(long)d?String.valueOf((long)d):String.valueOf(d);}
}

